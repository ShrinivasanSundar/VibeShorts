{
  "name": "vibeshorts-workspace",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace frontend",
    "dev:live": "bash scripts/dev-live.sh",
    "build:web": "npm run build --workspace frontend",
    "check:web": "npm run check --workspace frontend",
    "check:integrations": "uv run --project backend python backend/scripts/check-integrations.py",
    "emulators": "bash scripts/emulators.sh",
    "test:emulators": "bash scripts/emulators.sh test",
    "test:rules": "node --test backend/tests/rules.test.mjs",
    "stop": "powershell -ExecutionPolicy Bypass -File scripts/stop-dev.ps1",
    "inspector": "mcp-inspector"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@fontsource/inter": "5.3.0",
    "@modelcontextprotocol/inspector": "2.9.0",
    "firebase": "12.19.0",
    "firebase-tools": "15.32.1",
    "gsap": "3.15.0",
    "hyperframes": "0.8.116"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5",
    "@opentelemetry/core": "2.11.0",
    "basic-ftp": "6.2.1",
    "gaxios": {
      "uuid": "11.1.1"
    }
  }
}
