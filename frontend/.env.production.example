# Copy to frontend/.env.production.local for production builds and next start.
# next dev continues to use frontend/.env.local; replace it explicitly for live development.
# These values come from the Firebase WEB app configuration, not Vertex credentials.
# REQUIRED for the production frontend: mode, API origin, Firebase project/key/domain.
# Set the API URL to backend VIBESHORTS_PUBLIC_URL and the Firebase project to
# backend GOOGLE_CLOUD_PROJECT. Each required value below must be filled in.
NEXT_PUBLIC_MODE=production
NEXT_PUBLIC_API_URL=https://YOUR_API_HOST
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_PROJECT_ID.firebaseapp.com
# Emulator settings are LOCAL ONLY; omit both of these in production:
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL
# NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST
# No Vertex API key or application ADC credentials belong in this frontend file.
