# PRODUCTION BACKEND TEMPLATE
# Copy to backend/.env.production and replace YOUR_* values.
# REQUIRED: set for every production deployment.
# OPTIONAL: omit to use the documented application default.
# CONDITIONAL: required only for the specified provider, feature or test.
# Use a fresh shell without any *_EMULATOR_HOST variables.

# REQUIRED: these select real services; fixture/emulator mode is for local use.
VIBESHORTS_MODE=production
VIBESHORTS_PROVIDER=vertex

# OPTIONAL, LOCAL TESTING ONLY: real cloud services with both apps on loopback URLs.
# Default: false. With 1, HTTP is allowed only for localhost/127.0.0.1/::1 origins,
# the API binds to localhost, and the local pull worker processes real Pub/Sub jobs.
# Deployed services must leave this unset/0 and use HTTPS/internal service identities.
# VIBESHORTS_LOCAL_LIVE=1

# REQUIRED: application/Firebase project for Auth, Firestore, Storage and Pub/Sub.
GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID

# REQUIRED: private bucket NAME only, without gs:// or an object path.
VIBESHORTS_BUCKET=YOUR_PRIVATE_BUCKET

# REQUIRED: HTTPS API origin and frontend origin (used for OAuth and CORS).
VIBESHORTS_PUBLIC_URL=https://YOUR_API_HOST
VIBESHORTS_WEB_URL=https://YOUR_WEB_HOST

# REQUIRED: audience and allowlisted service identities for Pub/Sub/Scheduler ingress.
VIBESHORTS_INTERNAL_AUDIENCE=https://YOUR_API_HOST
VIBESHORTS_INTERNAL_SERVICE_EMAILS=YOUR_DISPATCHER_EMAIL,YOUR_SCHEDULER_EMAIL

# REQUIRED for vertex/developer: set a reviewed positive account allowance.
# All monetary amounts are integer micro-USD (1 USD = 1000000 micro-USD).
# The zero template value prevents enabling paid execution before configuration.
VIBESHORTS_PAID_ALLOWANCE_MICROS=0

# REQUIRED for vertex/developer: image rate profile, version and verification date.
# Reviewed standard Vertex rates on 2026-10-03: input $0.30/M, image output $30/M.
# Applying the image output rate to all output tokens is conservative for text.
# Historical example: review current rates before enabling paid execution.
# https://cloud.google.com/vertex-ai/generative-ai/pricing
VIBESHORTS_RATE_JSON='{"version":"vertex-standard-image-2026-10-03","verified_at":"2026-10-03","input_per_million_micros":300000,"output_per_million_micros":30000000}'

# CONDITIONAL rate-profile fields: add positive reviewed ceilings to the JSON above
# when enabling these operations. They are optional for an image-only deployment.
# video_per_second_micros: video generation
# video_rates: optional model-specific rates by resolution and audio, for example
# {"veo-3.1-lite-generate-001":{"720p:no_audio":30000,"720p:audio":50000,
# "1080p:no_audio":50000,"1080p:audio":80000}}. Review rates before use.
# music_per_call_micros: music generation
# director_reservation_micros: storyboards and director edits
# render_per_call_micros: Cloud Run rendering (local Docker rendering does not use it)
# A complete short using Cloud Run requires all four fields.

# OPTIONAL project budget override. Application default: 1000000 micro-USD.
# This example keeps project spending blocked until you set an approved amount.
VIBESHORTS_PROJECT_CAP_MICROS=0

# AUTHENTICATION: application ADC is required, but a credential-file env var is OPTIONAL.
# Omit on Cloud Run to use its service account, or locally to use existing gcloud ADC.
# Never commit credentials or Firebase ID tokens.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/existing-credentials.json

# OPTIONAL Vertex overrides: omit BOTH when Vertex uses the application project/ADC.
# Project defaults to GOOGLE_CLOUD_PROJECT; credentials default to application ADC.
# VIBESHORTS_VERTEX_PROJECT=YOUR_VERTEX_PROJECT_ID
# VIBESHORTS_VERTEX_CREDENTIALS=/absolute/path/to/vertex-credentials.json

# CONDITIONAL: required only when VIBESHORTS_PROVIDER=developer.
# Supply a server-only Gemini Developer API key; keep unset for the Vertex route.
# VIBESHORTS_DEVELOPER_API_KEY=YOUR_SERVER_API_KEY

# OPTIONAL model/location overrides; commented values show application defaults.
# These env overrides may be omitted even when the corresponding feature is enabled.
# Verify the selected model's availability in its configured location.
# VIBESHORTS_IMAGE_MODEL=gemini-2.5-flash-image
# VIBESHORTS_GOOGLE_LOCATION=global
# VIBESHORTS_VIDEO_MODEL=veo-3.1-generate-001
# VIBESHORTS_VIDEO_GENERATE_AUDIO=true
# Set false for silent workflow clips with the separately generated music track.
# VIBESHORTS_VIDEO_LOCATION=us-central1
# VIBESHORTS_MUSIC_MODEL=lyria-002
# VIBESHORTS_MUSIC_LOCATION=global
# VIBESHORTS_DIRECTOR_MODEL=gemini-2.5-flash
# VIBESHORTS_DEVELOPER_VIDEO_MODEL=veo-3.1-generate-preview
# VIBESHORTS_DEVELOPER_MUSIC_MODEL=lyria-3-clip-preview

# OPTIONAL director interpreter override. Default: backend/agents/creative_director/
# .venv/bin/python, resolved absolutely by the app. ADK is needed for live director work.
# VIBESHORTS_ADK_PYTHON=/absolute/path/to/backend/agents/creative_director/.venv/bin/python

# OPTIONAL rendering selection for video export. Application default: docker.
# This template chooses cloud_run; production also supports an isolated Docker renderer.
# The local runner is only supported in emulator mode.
VIBESHORTS_RENDER_RUNNER=cloud_run

# CONDITIONAL: required for cloud_run rendering; optional for image-only/Docker use.
VIBESHORTS_RENDER_CLOUD_JOB=projects/YOUR_PROJECT/locations/YOUR_REGION/jobs/vibeshorts-render

# CONDITIONAL Docker image override: used only for docker rendering.
# Default: vibeshorts-render:local. Build/deploy an appropriate renderer image.
# VIBESHORTS_RENDER_IMAGE=vibeshorts-render:local

# OPTIONAL operational overrides; defaults shown below.
# Topic is a NAME within GOOGLE_CLOUD_PROJECT, not a full projects/... URI.
# VIBESHORTS_TOPIC=vibeshorts-jobs
# VIBESHORTS_MAX_MEDIA_BYTES=200000000
# VIBESHORTS_LEASE_SECONDS=180
# VIBESHORTS_PROVIDER_TIMEOUT_SECONDS=90
# Provider timeout must remain shorter than the worker lease.

# OPTIONAL remote MCP client-registration override; built-in SDK/Inspector clients
# are used when omitted. Set exact allowed callbacks for additional clients.
# VIBESHORTS_OAUTH_CLIENTS_JSON='{"my-client":{"name":"My client","redirect_uris":["https://YOUR_CLIENT_HOST/callback"]}}'

# CONDITIONAL: all three required only when connecting through the stdio MCP transport.
# HTTP MCP uses OAuth instead. The token belongs to an authenticated Firebase user.
# VIBESHORTS_STDIO_FIREBASE_ID_TOKEN=...
# VIBESHORTS_STDIO_PROJECTS=project_id
# VIBESHORTS_STDIO_SCOPES=vibeshorts:read,vibeshorts:generate,vibeshorts:cancel

# OPTIONAL test-only values: not required to run the application.
# VIBESHORTS_SMOKE_FIREBASE_ID_TOKEN is required only for the live image smoke test.
# VIBESHORTS_SMOKE_FIREBASE_ID_TOKEN=...
# VIBESHORTS_RUN_PAID_SMOKE remains unset until the specific paid call is authorized.
