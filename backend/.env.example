# LOCAL FIXTURE TEMPLATE: copy to backend/.env for local emulators.
# For production, use backend/.env.production.example. It labels every setting
# as REQUIRED, OPTIONAL (default available), or CONDITIONAL (feature-specific).
# Do not copy the emulator hosts below into backend/.env.production.
VIBESHORTS_MODE=emulator
GOOGLE_CLOUD_PROJECT=demo-vibeshorts
# OPTIONAL in production: omit these to use GOOGLE_CLOUD_PROJECT and application ADC.
# VIBESHORTS_VERTEX_PROJECT=your-vertex-project
# VIBESHORTS_VERTEX_CREDENTIALS=/absolute/path/to/vertex-credentials.json
VIBESHORTS_BUCKET=demo-vibeshorts.appspot.com
# Bucket NAME only, without gs:// or an object path.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:18080
STORAGE_EMULATOR_HOST=http://127.0.0.1:9199
PUBSUB_EMULATOR_HOST=127.0.0.1:18085
VIBESHORTS_PUBLIC_URL=http://127.0.0.1:8000
VIBESHORTS_WEB_URL=http://127.0.0.1:3000
VIBESHORTS_PROVIDER=fixture
VIBESHORTS_PROJECT_CAP_MICROS=1000000
# REQUIRED for paid production: ADC, a positive paid allowance,
# and an explicit JSON rate profile; amounts are integer micro-USD.
# VIBESHORTS_PAID_ALLOWANCE_MICROS=1000000
# VIBESHORTS_RATE_JSON={"version":"reviewed-v1","input_per_million_micros":0,"output_per_million_micros":0,"verified_at":"YYYY-MM-DD"}
# OPTIONAL production model/location overrides (application defaults shown).
# VIBESHORTS_GOOGLE_LOCATION=global
# VIBESHORTS_IMAGE_MODEL=gemini-2.5-flash-image
# REQUIRED production internal-ingress configuration.
# VIBESHORTS_INTERNAL_AUDIENCE=https://worker.example.run.app
# VIBESHORTS_INTERNAL_SERVICE_EMAILS=dispatcher@project.iam.gserviceaccount.com,scheduler@project.iam.gserviceaccount.com

VIBESHORTS_RENDER_RUNNER=local
# Local rendering accepts only server-generated typed timelines. Production requires isolated rendering.
