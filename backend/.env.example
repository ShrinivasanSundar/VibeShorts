# ==============================================================================
# VibeShorts Backend Environment Configuration
# ==============================================================================
# Copy this file to `.env` in the `backend/` directory or set in your environment.

# ------------------------------------------------------------------------------
# 1. AI Models & Gemini Authentication (CRITICAL)
# ------------------------------------------------------------------------------
# Option A: Google AI Studio API Key (Easiest for development)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Option B: Vertex AI / Google Cloud ADC (Production / Cloud deployment)
# If using a Service Account JSON file instead of an API Key:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# Gemini Model Selection
GEMINI_DIRECTOR_MODEL=gemini-1.5-pro
GEMINI_LABELER_MODEL=gemini-1.5-flash
GEMINI_REVIEWER_MODEL=gemini-1.5-pro
GEMINI_MICRO_PROBE_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 2. Google Cloud Platform Configuration (for Firestore, STT, and GCS)
# ------------------------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
GCS_BUCKET_NAME=your-gcs-media-bucket
GCP_STT_RECOGNIZER=_

# ------------------------------------------------------------------------------
# 3. Application & Server Settings
# ------------------------------------------------------------------------------
APP_NAME="VibeShorts Backend"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# 4. External Binaries
# ------------------------------------------------------------------------------
# Path to ffmpeg executable on your machine
FFMPEG_PATH=ffmpeg
