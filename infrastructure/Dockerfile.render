FROM ghcr.io/astral-sh/uv:0.10.0 AS uv
FROM node:22.23.3-bookworm-slim AS node
FROM python:3.12-slim-bookworm
COPY --from=uv /uv /usr/local/bin/uv
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm
RUN npm install --global npm@11.13.0 --ignore-scripts --no-audit --no-fund
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 libasound2 libpango-1.0-0 libcairo2 fonts-liberation && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
COPY frontend/package.json frontend/package.json
RUN npm ci --ignore-scripts --no-audit --no-fund
RUN if [ "$(uname -m)" = "aarch64" ]; then \
      apt-get update && apt-get install -y --no-install-recommends chromium \
      && rm -rf /var/lib/apt/lists/* \
      && ln -s /usr/bin/chromium /usr/local/bin/hyperframes-chrome; \
    else \
      node_modules/.bin/hyperframes browser ensure \
      && ln -s "$(node_modules/.bin/hyperframes browser path)" /usr/local/bin/hyperframes-chrome \
      && chmod -R a+rX /root/.cache && chmod o+x /root; \
    fi
COPY backend/pyproject.toml backend/uv.lock backend/
RUN uv sync --project backend --frozen --no-dev --no-install-project
COPY backend/tools backend/tools
COPY backend/execution backend/execution
COPY backend/worker backend/worker
COPY backend/providers backend/providers
WORKDIR /app/backend
ENV PATH="/app/backend/.venv/bin:$PATH" HOME=/tmp XDG_CACHE_HOME=/tmp/.cache \
    HYPERFRAMES_BROWSER_PATH=/usr/local/bin/hyperframes-chrome \
    HYPERFRAMES_NO_TELEMETRY=1 DO_NOT_TRACK=1
USER 65532:65532
ENTRYPOINT ["node", "/app/node_modules/hyperframes/bin/hyperframes.mjs"]
