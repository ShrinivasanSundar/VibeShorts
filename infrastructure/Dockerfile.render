FROM ghcr.io/astral-sh/uv:0.10.0 AS uv
FROM node:22.23.3-bookworm-slim AS node
FROM python:3.12-slim-bookworm
COPY --from=uv /uv /usr/local/bin/uv
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 libasound2 libpango-1.0-0 libcairo2 fonts-liberation && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
RUN npm ci --ignore-scripts && node_modules/.bin/hyperframes browser ensure && ln -s "$(node_modules/.bin/hyperframes browser path)" /usr/local/bin/hyperframes-chrome && chmod -R a+rX /root/.cache && chmod o+x /root
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY tools tools
COPY execution execution
COPY worker worker
COPY providers providers
ENV PATH="/app/.venv/bin:$PATH" HYPERFRAMES_TELEMETRY_DISABLED=1
USER 65532:65532
ENTRYPOINT ["node", "/app/node_modules/hyperframes/bin/hyperframes.mjs"]
